{
  "schemaVersion": 1,
  "id": "spyglass-astronomy-sync",
  "version": "${version}",
  "name": "Spyglass Astronomy Sync",
  "description": "Multiplayer support for Spyglass Astronomy",
  "authors": [
    "fliplus"
  ],
  "contact": {
    "sources": "https://github.com/fliplus/spyglass-astronomy-sync"
  },
  "license": "LGPL-3.0",
  "icon": "assets/spyglass-astronomy-sync/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "fliplus.spyglassastronomysync.SpyglassAstronomySync"
    ],
    "client": [
      "fliplus.spyglassastronomysync.SpyglassAstronomySyncClient"
    ],
    "server": [
      "fliplus.spyglassastronomysync.SpyglassAstronomySyncServer"
    ]
  },
  "mixins": [
    "spyglass-astronomy-sync.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19",
    "minecraft": "${minecraft}",
    "java": ">=25",
    "fabric-api": "*"
  }
}
